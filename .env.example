# TreasureHunter Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-secret-key-here-change-this

# Production Mode
PRODUCTION_MODE=true

# Model weights (required in production)
# Path to serialized CNN weights file
CNN_WEIGHTS_PATH=/app/weights/archaeo_cnn.pth
# DOFA segmentation module path (must be a serialized torch.nn.Module in production)
USE_DOFA=true
DOFA_LOCAL_WEIGHTS=/app/weights/dofa.pth

# Satellite Data Providers
# Mapbox (easiest to get started)
MAPBOX_ACCESS_TOKEN=

# Google Earth Engine (for advanced satellite analysis)
GEE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Sentinel Hub (European Space Agency data)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Planet Labs (commercial satellite imagery)
PLANET_API_KEY=

# Optional API Keys for Enhanced Features
MINDAT_API_KEY=
USGS_API_KEY=

# Database (if using external database)
DATABASE_URL=

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379/0

# Model Storage
MODEL_STORAGE_PATH=/app/saved_models

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/treasurehunter.log

# Security
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
MAX_CONTENT_LENGTH=104857600  # 100MB max upload

# Performance
WORKERS=4
THREADS=2
TIMEOUT=120

# GPU Settings (for training)
CUDA_VISIBLE_DEVICES=0
USE_GPU=true

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100/hour
RATELIMIT_TRAINING=10/day
