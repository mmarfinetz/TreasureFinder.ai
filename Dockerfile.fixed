# syntax=docker/dockerfile:1.4
# Multi-stage build for TreasureHunter production deployment with GEE fix
# Stage 1: Builder
FROM python:3.10-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    libgdal-dev \
    libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Stage 2: Production
FROM python:3.10-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libgdal-dev \
    libspatialindex-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local

# Make sure scripts in .local are usable
ENV PATH=/root/.local/bin:$PATH

# Copy application files
COPY treasure_api.py .
COPY treasure_hunter_module.py .
COPY convert_notebook.py .
COPY frontend/ ./frontend/

# Copy the GEE lazy initialization patch
COPY gee_lazy_init_patch.py .

# Copy fixed API if available
COPY treasure_api_fixed.py .

# Copy deployment fix script
COPY railway_deploy_fix.sh .
RUN chmod +x railway_deploy_fix.sh

# Copy notebooks needed for conversion
COPY TreasurHunter.ipynb .
COPY satellite.ipynb .
COPY satellite_300mile.ipynb .
COPY satellite_production_modular_unified.ipynb .

# Create necessary directories
RUN mkdir -p saved_models logs

# Convert notebook to module (required for API)
RUN python convert_notebook.py && \
    test -f treasure_hunter_module.py || \
    (echo "ERROR: Failed to generate treasure_hunter_module.py" && exit 1)

# Apply the fix: Use the fixed API
RUN if [ -f treasure_api_fixed.py ]; then \
        cp treasure_api_fixed.py treasure_api.py; \
        echo "Applied fixed API with lazy GEE init"; \
    fi

# Set environment variables
ENV PRODUCTION_MODE=true
ENV FLASK_APP=treasure_api.py
ENV PYTHONUNBUFFERED=1

# Railway-specific: Mark as Railway environment
ENV RAILWAY_DEPLOYMENT=true

# Expose port
EXPOSE 5000

# Health check with extended start period for GEE init
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:${PORT:-5000}/healthz || exit 1

# Create startup script that handles credentials
RUN set -eux; \
    echo '#!/bin/sh' > /app/start.sh; \
    echo 'set -e' >> /app/start.sh; \
    echo '' >> /app/start.sh; \
    echo 'echo "🚀 Starting TreasureHunter API..."' >> /app/start.sh; \
    echo '' >> /app/start.sh; \
    echo '# Handle base64 credentials if present' >> /app/start.sh; \
    echo 'if [ -n "$GOOGLE_CREDENTIALS_B64" ]; then' >> /app/start.sh; \
    echo '    echo "📝 Decoding GEE credentials from base64..."' >> /app/start.sh; \
    echo '    echo "$GOOGLE_CREDENTIALS_B64" | base64 -d > /app/gee_sa.json 2>/dev/null || \' >> /app/start.sh; \
    echo '    echo "$GOOGLE_CREDENTIALS_B64" | base64 -D > /app/gee_sa.json 2>/dev/null || \' >> /app/start.sh; \
    echo '    echo "⚠️ Failed to decode credentials (will try as-is)"' >> /app/start.sh; \
    echo '    if [ -f /app/gee_sa.json ]; then' >> /app/start.sh; \
    echo '        export GOOGLE_APPLICATION_CREDENTIALS=/app/gee_sa.json' >> /app/start.sh; \
    echo '        echo "✅ Set GOOGLE_APPLICATION_CREDENTIALS"' >> /app/start.sh; \
    echo '    fi' >> /app/start.sh; \
    echo 'fi' >> /app/start.sh; \
    echo '' >> /app/start.sh; \
    echo '# Handle already-decoded JSON credentials' >> /app/start.sh; \
    echo 'if [ -n "$GEE_SERVICE_ACCOUNT_JSON" ] && [ ! -f /app/gee_sa.json ]; then' >> /app/start.sh; \
    echo '    echo "📝 Using GEE_SERVICE_ACCOUNT_JSON..."' >> /app/start.sh; \
    echo '    echo "$GEE_SERVICE_ACCOUNT_JSON" > /app/gee_sa.json' >> /app/start.sh; \
    echo '    export GOOGLE_APPLICATION_CREDENTIALS=/app/gee_sa.json' >> /app/start.sh; \
    echo '    echo "✅ Set GOOGLE_APPLICATION_CREDENTIALS"' >> /app/start.sh; \
    echo 'fi' >> /app/start.sh; \
    echo '' >> /app/start.sh; \
    echo '# Set project ID if available' >> /app/start.sh; \
    echo 'if [ -n "$GOOGLE_EARTH_ENGINE_PROJECT" ] && [ -z "$GEE_PROJECT_ID" ]; then' >> /app/start.sh; \
    echo '    export GEE_PROJECT_ID=$GOOGLE_EARTH_ENGINE_PROJECT' >> /app/start.sh; \
    echo '    echo "✅ Set GEE_PROJECT_ID from GOOGLE_EARTH_ENGINE_PROJECT"' >> /app/start.sh; \
    echo 'fi' >> /app/start.sh; \
    echo '' >> /app/start.sh; \
    echo 'echo "📊 Environment summary:"' >> /app/start.sh; \
    echo 'echo "  PORT: ${PORT:-5000}"' >> /app/start.sh; \
    echo 'echo "  WORKERS: ${WORKERS:-1}"' >> /app/start.sh; \
    echo 'echo "  GEE_PROJECT_ID: ${GEE_PROJECT_ID:-not set}"' >> /app/start.sh; \
    echo 'echo "  GOOGLE_APPLICATION_CREDENTIALS: ${GOOGLE_APPLICATION_CREDENTIALS:-not set}"' >> /app/start.sh; \
    echo '' >> /app/start.sh; \
    echo '# Start with gunicorn' >> /app/start.sh; \
    echo 'exec gunicorn \\' >> /app/start.sh; \
    echo '    --bind 0.0.0.0:${PORT:-5000} \\' >> /app/start.sh; \
    echo '    --workers ${WORKERS:-1} \\' >> /app/start.sh; \
    echo '    --threads ${THREADS:-2} \\' >> /app/start.sh; \
    echo '    --timeout 120 \\' >> /app/start.sh; \
    echo '    --preload \\' >> /app/start.sh; \
    echo '    --log-level info \\' >> /app/start.sh; \
    echo '    --access-logfile - \\' >> /app/start.sh; \
    echo '    --error-logfile - \\' >> /app/start.sh; \
    echo '    treasure_api:app' >> /app/start.sh; \
    chmod +x /app/start.sh

RUN chmod +x /app/start.sh

# Use the startup script as entrypoint
CMD ["/app/start.sh"]